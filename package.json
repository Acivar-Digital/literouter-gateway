{
  "name": "literouter",
  "version": "4.1.0",
  "description": "Ultra-fast declarative LLM API gateway and resilient proxy on Bun",
  "main": "src/index.ts",
  "types": "src/lib.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "test:raw": "bun test",
    "test:failures": "bun test --only-failures",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.5.4",
    "typescript": "^5.5.4"
  }
}